<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!--
    Same outer structure as dialog_menu.xml: fixed header above a scrollable RecyclerView.
    The LinearLayout lets the RecyclerView expand and scroll correctly inside BottomSheetDialog.
    -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:id="@+id/cover_picker_handle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Album art preview (current cover before any change) -->
        <org.oxycblt.auxio.image.CoverView
            android:id="@+id/cover_picker_cover"
            style="@style/Widget.Auxio.Image.MidFull"
            android:layout_marginStart="@dimen/spacing_medium"
            android:layout_marginBottom="@dimen/spacing_medium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cover_picker_handle" />

        <TextView
            android:id="@+id/cover_picker_type"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_medium"
            android:layout_marginTop="@dimen/spacing_small"
            android:textAppearance="?attr/textAppearanceLabelMediumEmphasized"
            android:textColor="?attr/colorSecondary"
            app:layout_constraintBottom_toTopOf="@+id/cover_picker_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/cover_picker_cover"
            app:layout_constraintTop_toTopOf="@+id/cover_picker_cover"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="Album" />

        <TextView
            android:id="@+id/cover_picker_name"
            style="@style/Widget.Auxio.TextView.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/cover_picker_info"
            app:layout_constraintEnd_toEndOf="@+id/cover_picker_type"
            app:layout_constraintStart_toStartOf="@+id/cover_picker_type"
            app:layout_constraintTop_toBottomOf="@+id/cover_picker_type"
            tools:text="Album Name" />

        <TextView
            android:id="@+id/cover_picker_info"
            style="@style/Widget.Auxio.TextView.Secondary.Marquee"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_small"
            android:textColor="?android:attr/textColorSecondary"
            app:layout_constraintBottom_toBottomOf="@+id/cover_picker_cover"
            app:layout_constraintEnd_toEndOf="@+id/cover_picker_type"
            app:layout_constraintStart_toStartOf="@+id/cover_picker_name"
            app:layout_constraintTop_toBottomOf="@+id/cover_picker_name"
            tools:text="Artist Name" />

        <com.google.android.material.divider.MaterialDivider
            android:id="@+id/cover_picker_divider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            app:layout_constraintTop_toBottomOf="@+id/cover_picker_cover" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <org.oxycblt.auxio.list.recycler.AuxioRecyclerView
        android:id="@+id/cover_picker_recycler"
        style="@style/Widget.Auxio.RecyclerView.Linear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="480dp"
        android:overScrollMode="never"
        tools:listitem="@layout/item_cover_thumbnail" />

</LinearLayout>

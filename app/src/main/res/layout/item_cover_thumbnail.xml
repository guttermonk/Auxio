<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:padding="@dimen/spacing_small">

    <!-- Square image that fills the grid cell -->
    <ImageView
        android:id="@+id/cover_thumbnail_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <!-- Selected indicator overlay, hidden by default -->
    <ImageView
        android:id="@+id/cover_thumbnail_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/spacing_tiny"
        android:background="@drawable/ui_selection_badge_bg"
        android:src="@drawable/ic_check_20"
        android:visibility="gone"
        app:tint="?attr/colorOnPrimary" />

</FrameLayout>
